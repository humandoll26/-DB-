# demo はローカルの確認用。production では必ず notion にする。
STORAGE_MODE=demo
PORT=3000
APP_ORIGIN=http://localhost:3000
# npm run password で生成。平文パスワードは保存しない。
APP_PASSWORD_HASH=
# 32文字以上のランダム値。例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
NOTION_TOKEN=
NOTION_RECEIPTS_DATA_SOURCE_ID=
NOTION_CUSTOMERS_DATA_SOURCE_ID=
NOTION_ISSUER_DATA_SOURCE_ID=
NOTION_AUDIT_DATA_SOURCE_ID=
# 永続ボリューム。単一プロセス・単一インスタンスで運用する。
DATA_DIR=.data
