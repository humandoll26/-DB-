{
  "name": "notion-receipts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --import tsx --env-file-if-exists=.env.local server/main.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --import tsx --env-file-if-exists=.env.local server/main.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "password": "node scripts/password.mjs",
    "check:notion": "node --import tsx --env-file-if-exists=.env.local scripts/check-notion.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "express": "5.1.0",
    "pdf-lib": "1.17.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsx": "4.20.6",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.7.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
